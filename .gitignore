# .gitignore

# Password files (never commit these!)
.miniflux-password
*.password
*-password.txt

# SOPS Age private keys (never commit these!)
keys.txt
age-key.txt
*.age-key

# Temporary files
*.tmp
*.swp
*~

# Build results
result
result-*

# Editor files
.vscode/
.idea/
*.iml

# Git worktrees
.worktrees/

# Plain-Private-Keys und Self-Signed CA-Material nie ins git
# (verwaltet via sops-nix, siehe secrets/rmfakecloud-ca.yaml)
secrets/rmfakecloud-ca/
